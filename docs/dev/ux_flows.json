    {
      "id": "F-06",
      "title": "Focus calls: Quick Focus from the plot",
      "from": "course level 3 lesson 6; docs/features/focus-calls.md",
      "rules": [
        "UX-61",
        "UX-27"
      ],
      "budget": 12,
      "levels": {
        "student": "Focus ▸ Quick Focus…, Start, step with PgDn, keep with Return, Esc.",
        "pro": "The pad: View + Menu starts it; the same keys on the pad."
      },
      "steps": [
        {
          "screen": "any",
          "control": "Lighting Studio tab",
          "expect": "the plot and its Focus button",
          "do": {
            "tab": "Lighting Studio"
          },
          "check": {
            "visible": [
              "focusMenuButton"
            ]
          }
        },
        {
          "screen": "Lighting Studio",
          "control": "Focus ▸ Quick Focus… ▸ Start",
          "expect": "the focus panel",
          "clicks": 3,
          "do": {
            "menu": "focusMenuButton",
            "item": "focusQuick"
          },
          "close": "focusStart",
          "check": {
            "window": "focusModeSetup",
