{
  "about": "The core flows of docs/dev/UX_RULES.md (Flows), machine copy. The walker's flows group (tools/uxwalk) drives each automated step offscreen on `show`; report.py turns the results into findings. Budgets are the clicks of each flow's path as designed on 2026-11-07 (manual steps included); a flow that grows past its budget is a finding (UX-66). Change both files together.",
  "show": "docs/course/shows/lesson-3-8-start.qlcc",
  "bar": {
    "said": "2026-11-07: \"this tool will be used by students and professionals .. so it needs some level of ease of use while being somewhat comprehensive.. that's a tight line to walk I know .. but if I have to explain everything all the time, even with training, then we've failed in the design.\"",
    "bar": "A student finds it from where they're working without being told; a pro isn't slowed down.",
    "checks": [
      {
        "id": "C-1",
        "check": "Every core flow has a click budget, and stays within it.",
        "how": "walker"
      },
      {
        "id": "C-2",
        "check": "No dead ends: each step's control is on the screen the step before left, or something on that screen points to it.",
        "how": "walker"
      },
      {
        "id": "C-3",
        "check": "Defaults work for the common case: a flow changes only what it is about; an Auto shows the number it chose.",
        "how": "walker, review"
      },
      {
        "id": "C-4",
        "check": "Depth goes behind the thing it belongs to (More ▾, ⋯, a right-click, a row that opens), not into a new menu item or tab.",
        "how": "review"
      },
      {
        "id": "C-5",
        "check": "Controls use the course's and help's words for the same thing.",
        "how": "review"
      },
      {
        "id": "C-6",
        "check": "No core flow needs a help page to find its next step.",
        "how": "walker, review"
      },
      {
        "id": "C-7",
        "check": "What a flow builds can be tried in Design from where it was built.",
        "how": "walker"
      },
      {
        "id": "C-8",
        "check": "A pro's shortcut (key, command line, typed number) sits beside the clicks, never instead of them.",
        "how": "review"
      }
    ]
  },
  "flows": [
    {
      "id": "F-01",
      "title": "Number a show into songs and fold them",
      "from": "course level 3 lesson 8; 2026-11-07 catch (UX-61)",
      "rules": [
        "UX-61",
        "UX-66"
      ],
      "budget": 6,
      "levels": {
        "student": "Find sections from the cue list, set Numbering once, fold a song.",
        "pro": "The Numbering hint's Use it link sets the scheme its numbers already follow (one click)."
      },
      "steps": [
        {
          "screen": "any",
          "control": "Show Tree tab",
          "expect": "the Show Tree",
          "do": {
            "tab": "Show Tree"
          }
        },
        {
          "screen": "Show Tree",
          "control": "the cue list's row",
          "expect": "the list's page",
          "do": {
            "node": "list"
          },
          "check": {
            "visible": [
              "stListAddSection"
            ]
          }
        },
        {
          "screen": "the list's page",
          "control": "Numbering (where sections come from)",
          "expect": "Numbering, or a line pointing to it, on the list's page",
          "find": {
            "widget": "stProdNumbering"
          },
          "pointer": [
            "Numbering"
          ]
        },
        {
          "screen": "Show Tree",
          "control": "right-click a cue: sections",
          "expect": "a section or Numbering item, or a pointer",
          "find": {
            "context": "cue",
            "item": "section|numbering"
          },
          "pointer": [
            "Numbering"
          ]
        },
        {
          "screen": "Show Tree",
          "control": "the production's row",
          "expect": "the production's page",
          "do": {
            "node": "production"
          },
          "check": {
            "visible": [
              "stProdNumbering"
            ]
          }
        },
        {
          "screen": "the production's page",
          "control": "Numbering ▸ Show.Part.Iteration",
          "expect": "song section rows in the tree",
          "clicks": 2,
          "do": {
            "choose": "stProdNumbering",
            "item": "^Show\\.Part\\.Iteration"
          },
          "check": {
            "rows": "section"
          }
        },
        {
          "screen": "Show Tree",
          "control": "a section's ▸",
          "expect": "its cues folded under it",
          "do": {
            "fold": "section"
          },
          "check": {
            "folded": "section"
          }
        }
      ]
    },
    {
      "id": "F-02",
      "title": "Put a key on a hit and fire it while building",
      "from": "course level 3 lesson 5; 2026-11-07 catch (UX-62)",
      "rules": [
        "UX-62",
        "UX-61"
      ],
      "budget": 6,
      "levels": {
        "student": "Right-click the hit, Learn Trigger…, press the key; select the hit and press it.",
        "pro": "The same key fires it in Operate; the Control Map lists every trigger."
      },
      "steps": [
        {
          "screen": "any",
          "control": "Show Tree tab",
          "expect": "the Show Tree",
          "do": {
            "tab": "Show Tree"
          }
        },
        {
          "screen": "Show Tree",
          "control": "right-click a hit ▸ Learn Trigger…",
          "expect": "the learn dialog hears a computer key (F7) and names it",
          "clicks": 3,
          "do": {
            "context": "hit",
            "item": "^(Learn Trigger|Trigger:)"
          },
          "dialog": [
            {
              "control": "press F7",
              "do": {
                "key": "F7"
              },
              "check": {
                "text": "Key . F7|F7"
              }
            }
          ],
          "close": "accept",
          "check": {
            "window": "controlLearnDialog"
          },
          "rule": "UX-62"
        },
        {
          "screen": "Show Tree",
          "control": "the hit's row (arms it)",
          "expect": "the hit selected",
          "do": {
            "node": "hit"
          }
        },
        {
          "screen": "Show Tree, Design",
          "control": "F7",
          "expect": "the hit plays, in Design",
          "do": {
            "key": "F7"
          },
          "check": {
            "running": true
          }
        }
      ]
    },
    {
      "id": "F-03",
      "title": "Patch a WLED, make it a wand, see the effect from the tip",
      "from": "2026-11-07 (UX-64, UX-65); docs/features/lighting-studio.md Wand",
      "rules": [
        "UX-65",
        "UX-61"
      ],
      "budget": 15,
      "levels": {
        "student": "Add the WLED, pick Wand as its pixel path, read Auto's turns, start it at the tip.",
        "pro": "Type String length and Staff diameter; Auto follows them."
      },
      "steps": [
        {
          "screen": "Fixtures",
          "control": "Add fixture ▸ WLED ▸ Lantern, Connection: Network (WLED), IP, OK",
          "expect": "a WLED patched",
          "clicks": 6,
          "manual": "The Add Fixture dialog's model tree and typed IP aren't driven yet; the canned show already has six WLED Lanterns."
        },
        {
          "screen": "any",
          "control": "Lighting Studio tab",
          "expect": "the plot",
          "do": {
            "tab": "Lighting Studio"
          }
        },
        {
          "screen": "Lighting Studio",
          "control": "right-click a WLED Lantern ▸ Fixture Properties…",
          "expect": "its properties, with Pixel path",
          "clicks": 2,
          "do": {
            "context": "plot:Lantern",
            "item": "^Fixture Properties"
          },
          "dialog": [
            {
              "control": "Pixel path ▸ Wand",
              "do": {
                "choose": "fixturePixelPath",
                "item": "^Wand"
              },
              "check": {
                "visible": [
                  "fixturePixelTurns",
                  "fixtureWandLength"
                ]
              }
            },
            {
              "control": "Turns: Auto",
              "do": {},
              "check": {
                "widgetText": [
                  "fixturePixelTurns",
                  "^Auto \\(\\d"
                ]
              }
            },
            {
              "control": "First LED at ▸ Top (the tip)",
              "do": {
                "choose": "fixtureWandStart",
                "item": "^Top"
              }
            }
          ],
          "close": "accept",
          "check": {
            "window": "*"
          },
          "rule": "UX-65"
        },
        {
          "screen": "Fixture Properties",
          "control": "Pixel path ▸ Wand; Turns reads Auto (58.5); First LED at ▸ Top (the tip); OK",
          "expect": "a wand wound from the tip, its turns shown",
          "clicks": 5,
          "manual": "Driven inside the step before (its dialog); counted here."
        },
        {
          "screen": "Lighting Studio rig view",
          "control": "an effect on the wand",
          "expect": "it starts at the tip",
          "manual": "A person looks: the rig view's drawing is checked on his rig (UX-56)."
        }
      ]
    },
    {
      "id": "F-04",
      "title": "Build a look in the Workbench and record it as a cue",
      "from": "docs/features/build.md, show-tree.md Record and duplicate; course level 2",
      "rules": [
        "UX-61",
        "UX-66"
      ],
      "budget": 11,
      "levels": {
        "student": "Open a scene in Build, play it, Record it into the cue list.",
        "pro": "Type record lit on the Show Tree's command line."
      },
      "steps": [
        {
          "screen": "any",
          "control": "Build tab",
          "expect": "Build",
          "do": {
            "tab": "Build"
          }
        },
        {
          "screen": "Build",
          "control": "+ Scene, drag a group onto it, drop a colour",
          "expect": "a look",
          "clicks": 3,
          "manual": "Drag and drop isn't driven; the next step opens a scene of the canned show instead."
        },
        {
          "screen": "Build ▸ Scenes",
          "control": "a scene in the navigator",
          "expect": "it in the Workbench",
          "do": {
            "code": "workbenchLoadScene"
          },
          "check": {
            "visible": [
              "workbenchPlay"
            ]
          }
        },
        {
          "screen": "the Workbench",
          "control": "Play",
          "expect": "it on the rig",
          "do": {
            "click": "workbenchPlay"
          },
          "check": {
            "visible": [
              "workbenchOnRig"
            ]
          }
        },
        {
          "screen": "the Workbench",
          "control": "record this as a cue",
          "expect": "a Record control, or a line pointing to the Show Tree's Record",
          "find": {
            "text": "^Record|record .*cue"
          },
          "pointer": [
            "Record"
          ]
        },
        {
          "screen": "any",
          "control": "Show Tree tab",
          "expect": "the Show Tree",
          "do": {
            "tab": "Show Tree"
          }
        },
        {
          "screen": "Show Tree",
          "control": "a cue",
          "expect": "its page",
          "do": {
            "node": "cue"
          }
        },
        {
          "screen": "Show Tree",
          "control": "Record ▸ Everything lit ▸ Record",
          "expect": "a new cue after it",
          "clicks": 3,
          "do": {
            "click": "stRecord"
          },
          "dialog": [
            {
              "control": "Everything lit",
              "do": {
                "click": "stRecord:lit"
              }
            }
          ],
          "close": "accept",
          "check": {
            "cues": 1
          }
        }
      ]
    },
