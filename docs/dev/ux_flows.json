    {
      "id": "F-11",
      "title": "Add a WLED string and play its effects",
      "from": "2026-11-07 his office WLED test (UX-67 to UX-72)",
      "rules": [
        "UX-67",
        "UX-68",
        "UX-70",
        "UX-72",
        "UX-66"
      ],
      "budget": 26,
      "levels": {
        "student": "Add the WLED with its IP, fix it on the device, build a Starburst cue that runs once, then a colour cue, then Locate.",
        "pro": "Add Fixture takes the IP and puts the WLED on its own universe in one dialog; the cue's Runs and At the end are in the Look Editor."
      },
      "steps": [
        {
          "screen": "any",
          "control": "Fixtures tab",
          "expect": "Fixture Manager",
          "clicks": 1,
          "do": {
            "tab": "Fixtures"
          },
          "check": {
            "visible": [
              "class:FixtureTreeWidget"
            ]
          }
        },
        {
          "screen": "Fixtures",
          "control": "Add Fixture ▸ WLED ▸ Effect Mode / Effect (15ch)",
          "expect": "the Add Fixture dialog with the WLED model",
          "clicks": 3,
          "do": {
            "menu": "text:^Add$",
            "item": "text:^Add fixture"
          },
          "keep": true,
          "dialog": [
            {
              "control": "search WLED",
              "do": {
                "type": "m_searchEdit",
                "text": "WLED"
              }
            },
            {
              "control": "WLED ▸ Effect Mode",
              "do": {
                "pick": "m_tree",
                "path": [
                  "^WLED$",
                  "^Effect Mode$"
                ]
              }
            },
            {
              "control": "Mode: Effect (15ch)",
              "do": {
                "choose": "m_modeCombo",
                "item": "^Effect \\(15ch\\)"
              }
            }
          ],
          "check": {
            "widgetText": [
              "m_modeCombo",
              "^Effect \\(15ch\\)"
            ]
          }
        },
        {
          "screen": "Add Fixture",
          "control": "Connection ▸ Network (WLED, JSON over Wi-Fi)",
          "expect": "an IP field; no universe or patch step",
          "clicks": 2,
          "in": "dialog",
          "do": {
            "choose": "label:Connection",
            "item": "^Network \\(WLED"
          },
          "check": {
            "enabled": [
              "label:IP address"
            ]
          }
        },
        {
          "screen": "Add Fixture",
