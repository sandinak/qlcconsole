    {
      "id": "F-09",
      "title": "Fountain pars and sprinkle loops from Read Segments",
      "from": "2026-11-07 (UX-64); docs/features/lighting-studio.md Fountains",
      "rules": [
        "UX-64",
        "UX-61"
      ],
      "budget": 11,
      "levels": {
        "student": "Add Fountain…, drop the pars and the WLED in, Pixel path Sprinkle loops, Read Segments.",
        "pro": "Edit Spans… to change what was read."
      },
      "steps": [
        {
          "screen": "Lighting Studio",
          "control": "Add ▸ Add Fountain… ▸ OK; drop pars in the base and a WLED in the gap",
          "expect": "a fountain with its lights",
          "clicks": 5,
          "manual": "Building the fountain and dropping lights into it is drag and drop on the plot; monitor_test drives it."
        },
        {
          "screen": "any",
          "control": "Lighting Studio tab",
          "expect": "the plot",
          "do": {
            "tab": "Lighting Studio"
          }
        },
        {
          "screen": "Lighting Studio",
          "control": "right-click a WLED Lantern ▸ Fixture Properties…",
          "expect": "Pixel path offers Sprinkle loops; Read Segments beside it",
          "clicks": 2,
          "do": {
            "context": "plot:Lantern",
            "item": "^Fixture Properties"
          },
          "dialog": [
            {
              "control": "Pixel path offers Sprinkle loops",
              "do": {},
              "check": {
                "comboHas": [
                  "fixturePixelPath",
                  "Sprinkle loops"
                ]
              }
            }
          ],
          "close": "reject",
          "check": {
            "window": "*"
          },
          "rule": "UX-64"
        },
        {
          "screen": "Fixture Properties",
          "control": "Pixel path ▸ Sprinkle loops (in a fountain)",
          "expect": "Points, Spans, Read Segments",
          "clicks": 2,
          "manual": "The entry is enabled only for a light in a fountain's gap, which the canned show has none of (built in step 1)."
        },
        {
          "screen": "the fixture's fields",
          "control": "Read Segments",
          "expect": "Read 6 segments as spans at 3 points.",
          "clicks": 1,
          "manual": "Reads /json/state from a WLED on the network; monitor_test feeds it canned segments, and the walker has no device."
        }
      ]
    },
