            <Speed FadeIn="0" FadeOut="0" Duration="0"/>
            <Direction>Forward</Direction>
            <RunOrder>Loop</RunOrder>
            <SpeedModes FadeIn="Default" FadeOut="Default" Duration="PerStep"/>
            <Step Number="0" FadeIn="0" Hold="1000" FadeOut="0">10</Step>
            <Step Number="1" FadeIn="0" Hold="1000" FadeOut="0">11</Step>
            <Step Number="2" FadeIn="0" Hold="1000" FadeOut="0">12</Step>
            <Step Number="3" FadeIn="0" Hold="1000" FadeOut="0">13</Step>
        </Function>
