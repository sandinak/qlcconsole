 <Profile Manufacturer="Generic" Model="4-port Art-Net node" Protocol="ArtNet" Ports="4"/>
 <Profile Manufacturer="Generic" Model="8-port Art-Net node" Protocol="ArtNet" Ports="8"/>
 <Profile Manufacturer="Generic" Model="16-port Art-Net node" Protocol="ArtNet" Ports="16"/>
</DeviceProfiles>
