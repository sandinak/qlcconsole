<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.14.2</Version>
  <Author>qlcconsole</Author>
 </Creator>
 <Manufacturer>Generic</Manufacturer>
 <Model>IR Candle Remote</Model>
 <Type>Other</Type>
 <Channel Name="Select">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0">Nothing</Capability>
  <Capability Min="1" Max="1">On</Capability>
  <Capability Min="2" Max="2">Off</Capability>
  <Capability Min="3" Max="3">Candle (flicker)</Capability>
  <Capability Min="4" Max="4">Light (steady)</Capability>
  <Capability Min="5" Max="5" Press="true">Dim</Capability>
  <Capability Min="6" Max="6" Press="true">Brighten</Capability>
  <Capability Min="7" Max="255">Nothing</Capability>
 </Channel>
 <Channel Name="Window">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="254">Resend for 0 - 25.4 s (tenths of a second)</Capability>
  <Capability Min="255" Max="255">Resend constantly</Capability>
 </Channel>
 <Mode Name="Select + Window">
  <Channel Number="0">Select</Channel>
  <Channel Number="1">Window</Channel>
 </Mode>
 <Physical>
  <Bulb Type="" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0.2" Width="100" Height="50" Depth="100"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="0" DmxConnector="Other"/>
  <Body Shape="Box" Emission="None"/>
 </Physical>
</FixtureDefinition>
