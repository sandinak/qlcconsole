<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.14.2 GIT</Version>
  <Author>Branson</Author>
 </Creator>
 <Manufacturer>Junman</Manufacturer>
 <Model>2 Head</Model>
 <Type>Moving Head</Type>
 <!--
   Each head has a Pan channel that is SPLIT:
     DMX   0-127 = a single 360-degree (CCW) sweep, held = absolute/indexed
                   positioning. Marked RotationIndexed so position math knows
                   this band is an angle, not a speed.
     DMX 128-191 = continuous rotation clockwise, slow to fast
     DMX 192-255 = continuous rotation counter-clockwise, slow to fast
   Because the indexed band is exactly one 360-degree turn, PanMax = 360: the
   engine maps 0..360 degrees across DMX 0..127 only and clamps so it never
   spills into the continuous-rotation band above 127. (Use RotationIndexed,
   NOT a Clockwise/CounterClockwise preset, or the fix will not engage.)
 -->
 <Channel Name="Pan Head 1">
  <Group Byte="0">Pan</Group>
  <Capability Min="0" Max="127" Preset="RotationIndexed">Indexed position</Capability>
  <Capability Min="128" Max="191" Preset="RotationClockwiseSlowToFast">Rotate CW slow to fast</Capability>
  <Capability Min="192" Max="255" Preset="RotationCounterClockwiseSlowToFast">Rotate CCW slow to fast</Capability>
 </Channel>
 <Channel Name="Pan Fine Head 1" Preset="PositionPanFine"/>
 <Channel Name="Tilt Head 1" Preset="PositionTilt"/>
 <Channel Name="Tilt Fine Head 1" Preset="PositionTiltFine"/>
 <Channel Name="Dimmer Head 1" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red Head 1" Preset="IntensityRed"/>
 <Channel Name="Green Head 1" Preset="IntensityGreen"/>
 <Channel Name="Blue Head 1" Preset="IntensityBlue"/>
 <Channel Name="Pan Head 2">
  <Group Byte="0">Pan</Group>
  <Capability Min="0" Max="127" Preset="RotationIndexed">Indexed position</Capability>
  <Capability Min="128" Max="191" Preset="RotationClockwiseSlowToFast">Rotate CW slow to fast</Capability>
  <Capability Min="192" Max="255" Preset="RotationCounterClockwiseSlowToFast">Rotate CCW slow to fast</Capability>
 </Channel>
 <Channel Name="Pan Fine Head 2" Preset="PositionPanFine"/>
 <Channel Name="Tilt Head 2" Preset="PositionTilt"/>
 <Channel Name="Tilt Fine Head 2" Preset="PositionTiltFine"/>
 <Channel Name="Dimmer Head 2" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red Head 2" Preset="IntensityRed"/>
 <Channel Name="Green Head 2" Preset="IntensityGreen"/>
 <Channel Name="Blue Head 2" Preset="IntensityBlue"/>
 <Mode Name="16 Channel">
  <Physical>
   <Bulb Type="LED" Lumens="3000" ColourTemperature="6500"/>
   <Dimensions Weight="6" Width="300" Height="350" Depth="220"/>
   <Lens Name="Other" DegreesMin="14" DegreesMax="14"/>
   <Focus Type="Head" PanMax="360" TiltMax="270"/>
   <Technical PowerConsumption="180" DmxConnector="3-pin"/>
  </Physical>
  <Channel Number="0">Pan Head 1</Channel>
  <Channel Number="1">Pan Fine Head 1</Channel>
  <Channel Number="2">Tilt Head 1</Channel>
  <Channel Number="3">Tilt Fine Head 1</Channel>
  <Channel Number="4">Dimmer Head 1</Channel>
  <Channel Number="5">Red Head 1</Channel>
  <Channel Number="6">Green Head 1</Channel>
  <Channel Number="7">Blue Head 1</Channel>
  <Channel Number="8">Pan Head 2</Channel>
  <Channel Number="9">Pan Fine Head 2</Channel>
  <Channel Number="10">Tilt Head 2</Channel>
  <Channel Number="11">Tilt Fine Head 2</Channel>
  <Channel Number="12">Dimmer Head 2</Channel>
  <Channel Number="13">Red Head 2</Channel>
  <Channel Number="14">Green Head 2</Channel>
  <Channel Number="15">Blue Head 2</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
   <Channel>4</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
   <Channel>7</Channel>
  </Head>
  <Head>
   <Channel>8</Channel>
   <Channel>9</Channel>
   <Channel>10</Channel>
   <Channel>11</Channel>
   <Channel>12</Channel>
   <Channel>13</Channel>
   <Channel>14</Channel>
   <Channel>15</Channel>
  </Head>
 </Mode>
</FixtureDefinition>
