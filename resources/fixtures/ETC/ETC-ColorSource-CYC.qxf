<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.14.2+qlcconsole.1972</Version>
  <Author>Branson Matheson</Author>
 </Creator>
 <Manufacturer>ETC</Manufacturer>
 <Model>ColorSource CYC</Model>
 <Type>Color Changer</Type>
 <Channel Name="Intensity" Preset="IntensityDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Indigo" Preset="IntensityIndigo"/>
 <Channel Name="Lime" Preset="IntensityLime"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">No strobe</Capability>
  <Capability Min="1" Max="254" Preset="StrobeFreqRange" Res1="1" Res2="33">Strobe (1 to 33 per second)</Capability>
  <Capability Min="255" Max="255" Preset="ShutterOpen">No strobe</Capability>
 </Channel>
 <Channel Name="Intensity (Preset 1)" Preset="IntensityDimmer"/>
 <Mode Name="5-Channel">
  <Channel Number="0">Intensity</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">Strobe</Channel>
 </Mode>
 <Mode Name="Direct">
  <Channel Number="0">Intensity</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">Indigo</Channel>
  <Channel Number="5">Lime</Channel>
  <Channel Number="6">Strobe</Channel>
 </Mode>
 <Mode Name="1-Channel">
  <Channel Number="0">Intensity (Preset 1)</Channel>
 </Mode>
 <Mode Name="RGB">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="4117" ColourTemperature="0"/>
  <Dimensions Weight="4.67" Width="266" Height="304" Depth="221"/>
  <!-- ETC publishes no beam angle ("N/A (asymmetrical)", ColorSource CYC
       data sheet Rev D 1/20). Its photometrics blend units 3.4 ft apart at
       2 ft back, so the spread is at least 2*atan(1.7/2) = 80 degrees; a
       100 degree flood is drawn. -->
  <Lens Name="Other" DegreesMin="100" DegreesMax="100"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="133" DmxConnector="5-pin"/>
 </Physical>
</FixtureDefinition>
