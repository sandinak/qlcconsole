<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ProgrammerMap>
<ProgrammerMap>
  <Manufacturer>Akai</Manufacturer>
  <Model>APC40 mkII</Model>
  <Profile>Akai-APC40-mkII.qxi</Profile>
  <GridColumns>10</GridColumns>

  <!-- Channel-strip layout (one VC column per Mk2 channel column),
       ordered to mirror the device's physical top→bottom layout:
         Row 0:  Knob 1..8      (LED-ring knob, top of the device)
                                — beam controls (Pan/Tilt + Zoom/
                                Focus/Shutter/Speed)
         Rows 2..6: 5×8 clip pad matrix (pads only in cols 0..7).
                   Right-knob row sits in cols 10..13 at rows 5..6
                   (rowSpan=2) — aspect controls (Prism/Effect2/
                   Gobo/Gobo2). Bottom-aligns with the last pad row.
         Row 7:  Clip Stop      → SelectFixtures Replace ("set")
         Row 8:  Activator (R)  → SelectFixtures Toggle  ("tog")
         Row 9:  Track Select   → SelectFixtures Add     ("add")
         Row 10: Fader 1..8     → per-column color
         Row 11: SHIFT / BANK   → ChaserPrev / ChaserNext
                                  (bottom-right corner, cols 12/13)
       Master section on cols 8/9 (lots of free real estate above
       master — ≈7 buttons + a knob worth of space, intentionally
       left blank for now):
         Row 0:  RECORD          → SaveProgrammer (col 9, RED)
         Row 2:  PAN             → Pad mode (col 9, top of pad grid)
         Row 7:  Stop All Clips  → Clear (col 8)
         Row 8:  USER            → RevertProgrammer (col 9)
         Row 10: Master fader    → GrandMaster (col 8)

       Per-column param/color assignment (knob = beam-pointing
       parameter, fader = color):
         col 0:  Pan       / Red
         col 1:  Pan-LSB   / Green
         col 2:  Tilt      / Blue
         col 3:  Tilt-LSB  / White
         col 4:  Zoom      / Amber
         col 5:  Focus     / UV
         col 6:  Shutter   / Color (wheel)
         col 7:  Speed     / Intensity (per-fixture dimmer)

       Channel encoding: (MIDI channel - 1) * 4096 + CC/Note. -->

  <!-- Row 0 — channel-strip knobs (Knob 1..8, channels 48..55):
       per-fixture Pan / Tilt / Shutter / Gobo / Speed / Prism. -->
  <!-- Top knobs are beam controls (Pan/Tilt + Zoom/Focus/Shutter/Speed):
       what we're pointing at and how the beam is shaped. Aspect-of-
       light controls (gobos, prism) live on the right-knob block
       below — strict one-knob-per-parameter, no duplicates. -->
  <Mapping channel="48" kind="ParameterSlider" role="Pan"     controlByte="MSB" style="Knob" row="0" column="0"/>
  <Mapping channel="49" kind="ParameterSlider" role="Pan"     controlByte="LSB" style="Knob" row="0" column="1"/>
  <Mapping channel="50" kind="ParameterSlider" role="Tilt"    controlByte="MSB" style="Knob" row="0" column="2"/>
  <Mapping channel="51" kind="ParameterSlider" role="Tilt"    controlByte="LSB" style="Knob" row="0" column="3"/>
  <Mapping channel="52" kind="ParameterSlider" role="Zoom"    controlByte="MSB" style="Knob" row="0" column="4"/>
  <Mapping channel="53" kind="ParameterSlider" role="Focus"   controlByte="MSB" style="Knob" row="0" column="5"/>
  <Mapping channel="54" kind="ParameterSlider" role="Shutter" controlByte="MSB" style="Knob" row="0" column="6"/>
  <Mapping channel="55" kind="ParameterSlider" role="Speed"   controlByte="MSB" style="Knob" row="0" column="7"/>

  <!-- Right-side Device Control knobs — aspect / character of light
       (gobos, prism). Single row of 4 (cols 10..13) at the bottom of
       the pad matrix (rowSpan=2 so each knob stretches across the
       last two pad rows, bottom-aligning with the final pad row).
       Strict one-knob-per-parameter:
         Prism      — prism in/out
         Effect2    — prism speed/rotation (RoleEffect2's documented use)
         Gobo       — gobo wheel position
         Gobo2      — gobo indexer / rotating gobo (RoleGobo2's
                      documented use on mover-style fixtures)
       Channels 20..23 (Knob 13..16, the 4 lower device-control
       knobs) are intentionally unmapped — there isn't a clean
       distinct role left for them, and we'd rather have no knob
       than a duplicate or a misleading label. -->
  <Mapping channel="16" kind="ParameterSlider" role="Prism"   controlByte="MSB" style="Knob" row="5" column="10" rowSpan="2"/>
  <Mapping channel="17" kind="ParameterSlider" role="Effect2" controlByte="MSB" style="Knob" row="5" column="11" rowSpan="2"/>
  <Mapping channel="18" kind="ParameterSlider" role="Gobo"    controlByte="MSB" style="Knob" row="5" column="12" rowSpan="2"/>
  <Mapping channel="19" kind="ParameterSlider" role="Gobo2"   controlByte="MSB" style="Knob" row="5" column="13" rowSpan="2"/>

  <!-- 5×8 pad matrix at rows 2..6 (below the two knob rows, mirroring
       the device). padRow 0 = top of physical grid (Button 1-X =
       ch 160..167). padRow 4 = bottom (Button 5-X = ch 128..135).
       In FixtureSelect mode each cell toggles the fixture at index
       (padRow * 8 + padCol) within the active group's fixtureList. -->
  <Mapping channel="160" kind="FixturePadCellButton" padRow="0" padCol="0" row="2" column="0"/>
  <Mapping channel="161" kind="FixturePadCellButton" padRow="0" padCol="1" row="2" column="1"/>
  <Mapping channel="162" kind="FixturePadCellButton" padRow="0" padCol="2" row="2" column="2"/>
  <Mapping channel="163" kind="FixturePadCellButton" padRow="0" padCol="3" row="2" column="3"/>
  <Mapping channel="164" kind="FixturePadCellButton" padRow="0" padCol="4" row="2" column="4"/>
  <Mapping channel="165" kind="FixturePadCellButton" padRow="0" padCol="5" row="2" column="5"/>
  <Mapping channel="166" kind="FixturePadCellButton" padRow="0" padCol="6" row="2" column="6"/>
  <Mapping channel="167" kind="FixturePadCellButton" padRow="0" padCol="7" row="2" column="7"/>

  <Mapping channel="152" kind="FixturePadCellButton" padRow="1" padCol="0" row="3" column="0"/>
  <Mapping channel="153" kind="FixturePadCellButton" padRow="1" padCol="1" row="3" column="1"/>
  <Mapping channel="154" kind="FixturePadCellButton" padRow="1" padCol="2" row="3" column="2"/>
  <Mapping channel="155" kind="FixturePadCellButton" padRow="1" padCol="3" row="3" column="3"/>
  <Mapping channel="156" kind="FixturePadCellButton" padRow="1" padCol="4" row="3" column="4"/>
  <Mapping channel="157" kind="FixturePadCellButton" padRow="1" padCol="5" row="3" column="5"/>
  <Mapping channel="158" kind="FixturePadCellButton" padRow="1" padCol="6" row="3" column="6"/>
  <Mapping channel="159" kind="FixturePadCellButton" padRow="1" padCol="7" row="3" column="7"/>

  <Mapping channel="144" kind="FixturePadCellButton" padRow="2" padCol="0" row="4" column="0"/>
  <Mapping channel="145" kind="FixturePadCellButton" padRow="2" padCol="1" row="4" column="1"/>
  <Mapping channel="146" kind="FixturePadCellButton" padRow="2" padCol="2" row="4" column="2"/>
  <Mapping channel="147" kind="FixturePadCellButton" padRow="2" padCol="3" row="4" column="3"/>
  <Mapping channel="148" kind="FixturePadCellButton" padRow="2" padCol="4" row="4" column="4"/>
  <Mapping channel="149" kind="FixturePadCellButton" padRow="2" padCol="5" row="4" column="5"/>
  <Mapping channel="150" kind="FixturePadCellButton" padRow="2" padCol="6" row="4" column="6"/>
  <Mapping channel="151" kind="FixturePadCellButton" padRow="2" padCol="7" row="4" column="7"/>

  <Mapping channel="136" kind="FixturePadCellButton" padRow="3" padCol="0" row="5" column="0"/>
  <Mapping channel="137" kind="FixturePadCellButton" padRow="3" padCol="1" row="5" column="1"/>
  <Mapping channel="138" kind="FixturePadCellButton" padRow="3" padCol="2" row="5" column="2"/>
  <Mapping channel="139" kind="FixturePadCellButton" padRow="3" padCol="3" row="5" column="3"/>
  <Mapping channel="140" kind="FixturePadCellButton" padRow="3" padCol="4" row="5" column="4"/>
  <Mapping channel="141" kind="FixturePadCellButton" padRow="3" padCol="5" row="5" column="5"/>
  <Mapping channel="142" kind="FixturePadCellButton" padRow="3" padCol="6" row="5" column="6"/>
  <Mapping channel="143" kind="FixturePadCellButton" padRow="3" padCol="7" row="5" column="7"/>

  <Mapping channel="128" kind="FixturePadCellButton" padRow="4" padCol="0" row="6" column="0"/>
  <Mapping channel="129" kind="FixturePadCellButton" padRow="4" padCol="1" row="6" column="1"/>
  <Mapping channel="130" kind="FixturePadCellButton" padRow="4" padCol="2" row="6" column="2"/>
  <Mapping channel="131" kind="FixturePadCellButton" padRow="4" padCol="3" row="6" column="3"/>
  <Mapping channel="132" kind="FixturePadCellButton" padRow="4" padCol="4" row="6" column="4"/>
  <Mapping channel="133" kind="FixturePadCellButton" padRow="4" padCol="5" row="6" column="5"/>
  <Mapping channel="134" kind="FixturePadCellButton" padRow="4" padCol="6" row="6" column="6"/>
  <Mapping channel="135" kind="FixturePadCellButton" padRow="4" padCol="7" row="6" column="7"/>

  <!-- Row 7 — Clip-Stop track-row buttons → SelectFixtures (Replace).
       Topmost button under each pad column on the physical Mk2.
       Plus "Stop All Clips" → ClearSelection at the right end (col 8). -->
  <Mapping channel="180"   kind="SelectFixturesButton" mode="Replace" row="7" column="0"/>
  <Mapping channel="4276"  kind="SelectFixturesButton" mode="Replace" row="7" column="1"/>
  <Mapping channel="8372"  kind="SelectFixturesButton" mode="Replace" row="7" column="2"/>
  <Mapping channel="12468" kind="SelectFixturesButton" mode="Replace" row="7" column="3"/>
  <Mapping channel="16564" kind="SelectFixturesButton" mode="Replace" row="7" column="4"/>
  <Mapping channel="20660" kind="SelectFixturesButton" mode="Replace" row="7" column="5"/>
  <Mapping channel="24756" kind="SelectFixturesButton" mode="Replace" row="7" column="6"/>
  <Mapping channel="28852" kind="SelectFixturesButton" mode="Replace" row="7" column="7"/>
  <Mapping channel="209"   kind="ClearSelectionButton"                 row="7" column="8"/>

  <!-- Row 8 — Track Activator buttons (R 1..8) → SelectFixtures (Toggle). -->
  <Mapping channel="176"   kind="SelectFixturesButton" mode="Toggle" row="8" column="0"/>
  <Mapping channel="4272"  kind="SelectFixturesButton" mode="Toggle" row="8" column="1"/>
  <Mapping channel="8368"  kind="SelectFixturesButton" mode="Toggle" row="8" column="2"/>
  <Mapping channel="12464" kind="SelectFixturesButton" mode="Toggle" row="8" column="3"/>
  <Mapping channel="16560" kind="SelectFixturesButton" mode="Toggle" row="8" column="4"/>
  <Mapping channel="20656" kind="SelectFixturesButton" mode="Toggle" row="8" column="5"/>
  <Mapping channel="24752" kind="SelectFixturesButton" mode="Toggle" row="8" column="6"/>
  <Mapping channel="28848" kind="SelectFixturesButton" mode="Toggle" row="8" column="7"/>

  <!-- Row 9 — Track Select buttons (1..8) → SelectFixtures (Add). -->
  <Mapping channel="178"   kind="SelectFixturesButton" mode="Add" row="9" column="0"/>
  <Mapping channel="4274"  kind="SelectFixturesButton" mode="Add" row="9" column="1"/>
  <Mapping channel="8370"  kind="SelectFixturesButton" mode="Add" row="9" column="2"/>
  <Mapping channel="12466" kind="SelectFixturesButton" mode="Add" row="9" column="3"/>
  <Mapping channel="16562" kind="SelectFixturesButton" mode="Add" row="9" column="4"/>
  <Mapping channel="20658" kind="SelectFixturesButton" mode="Add" row="9" column="5"/>
  <Mapping channel="24754" kind="SelectFixturesButton" mode="Add" row="9" column="6"/>
  <Mapping channel="28850" kind="SelectFixturesButton" mode="Add" row="9" column="7"/>

  <!-- Row 10 — channel-strip faders → colors. Master fader → GrandMaster. -->
  <Mapping channel="7"     kind="ParameterSlider" role="Red"    controlByte="MSB" row="10" column="0"/>
  <Mapping channel="4103"  kind="ParameterSlider" role="Green"  controlByte="MSB" row="10" column="1"/>
  <Mapping channel="8199"  kind="ParameterSlider" role="Blue"   controlByte="MSB" row="10" column="2"/>
  <Mapping channel="12295" kind="ParameterSlider" role="White"  controlByte="MSB" row="10" column="3"/>
  <Mapping channel="16391" kind="ParameterSlider" role="Amber"  controlByte="MSB" row="10" column="4"/>
  <Mapping channel="20487" kind="ParameterSlider" role="UV"     controlByte="MSB" row="10" column="5"/>
  <Mapping channel="24583" kind="ParameterSlider" role="Color"  controlByte="MSB" row="10" column="6"/>
  <Mapping channel="28679" kind="ParameterSlider" role="Dimmer" controlByte="MSB" row="10" column="7"/>
  <Mapping channel="14"    kind="GrandMasterSlider"                                row="10" column="8"/>

  <!-- Master section spans cols 8 + 9. Layout mirrors the Mk2's
       right-side panel:
                                     Col 8           Col 9
         Row 0  (knobs)                -              RECORD (red)
         Row 2  (top of pad grid)      -              PAN (Pad mode)
         Row 7  (clip-stop)           Clear            -
         Row 8  (activator)            -              USER (Revert)
         Row 10 (faders)              Master fader     -
         Row 11 (under master)        SHIFT (Prev)    BANK (Next)
       Cols 8/9 rows 1, 3-6, 9 left empty for now (≈ 7 buttons + a
       knob worth of real estate above the master — to be filled
       with SENDS / scene-launch / cue / metronome later). -->
  <Mapping channel="221" kind="SaveProgrammerButton"   row="0" column="9"/>
  <!-- rowSpan=2 keeps the button at its natural 60px height while
       letting layout row 2 stay 35px tall (so the pad grid above
       and below stays uniformly spaced). The button's bottom
       extends a little into row 3, which is fine since col 9 is
       empty there. -->
  <Mapping channel="215" kind="PadModeButton" padMode="FixtureSelect"
                                              row="2" column="9" rowSpan="2"/>
  <Mapping channel="217" kind="RevertProgrammerButton" row="8" column="9"/>
  <!-- Step buttons in the bottom-right corner of the entire frame
       (col 12/13, below the right-knob block, well clear of the
       master fader's column). -->
  <Mapping channel="226" kind="ChaserStepPrevButton"   row="11" column="12"/>
  <Mapping channel="231" kind="ChaserStepNextButton"   row="11" column="13"/>
</ProgrammerMap>
