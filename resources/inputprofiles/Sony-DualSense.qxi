<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE InputProfile>
<InputProfile xmlns="http://www.qlcplus.org/InputProfile">
 <Creator>
  <Name>qlcconsole</Name>
  <Version>0.3.1</Version>
  <Author>Branson Matheson</Author>
 </Creator>
 <!-- The channels the HID plugin reads this pad into (on a Mac, and on
      Linux for the pads it knows): the controller profile's layout,
      axes first, then the buttons, then the touchpad's fingers. -->
 <Manufacturer>Sony</Manufacturer>
 <Model>DualSense</Model>
 <Type>HID</Type>
 <Channel Number="0">
  <Name>Left Stick X</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="1">
  <Name>Left Stick Y</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="2">
  <Name>L2</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="3">
  <Name>Right Stick X</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="4">
  <Name>Right Stick Y</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="5">
  <Name>R2</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="6">
  <Name>Cross</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="7">
  <Name>Circle</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="8">
  <Name>Square</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="9">
  <Name>Triangle</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="10">
  <Name>L1</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="11">
  <Name>R1</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="12">
  <Name>Create</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="13">
  <Name>Options</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="14">
  <Name>L3</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="15">
  <Name>R3</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="16">
  <Name>PS</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="17">
  <Name>D-pad Up</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="18">
  <Name>D-pad Down</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="19">
  <Name>D-pad Left</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="20">
  <Name>D-pad Right</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="21">
  <Name>Touchpad</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="22">
  <Name>Touch X</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="23">
  <Name>Touch Y</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="24">
  <Name>Touch</Name>
  <Type>Button</Type>
 </Channel>
 <Channel Number="25">
  <Name>Second Touch X</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="26">
  <Name>Second Touch Y</Name>
  <Type>Slider</Type>
 </Channel>
 <Channel Number="27">
  <Name>Second Touch</Name>
  <Type>Button</Type>
 </Channel>
</InputProfile>
