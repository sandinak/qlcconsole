<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>qlcconsole.icns</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>__QLC_VERSION__</string>

	<key>CFBundleVersion</key>
	<string>__QLC_BUILD__</string>

	<!-- Qt 6.9's own minimum: on 11, Finder says so instead of a crash. -->
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>

	<key>CFBundleSignature</key>
	<string>????</string>

	<key>CFBundleExecutable</key>
	<string>qlcconsole-launcher</string>

	<key>CFBundleName</key>
	<string>qlcconsole</string>

	<key>CFBundleIdentifier</key>
	<string>com.bransonmatheson.qlcconsole</string>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSHighResolutionCapable</key>
	<string>True</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Process incoming audio</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>Access the local network for DMX-related protocols</string>

	<!-- Game controllers (Focus mode, the follow spot) need no key here and
	     no entitlement under the hardened runtime, in the foreground or the
	     background: there is no usage-description key for Input Monitoring,
	     whose prompt (when macOS asks at all) has fixed text. -->

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>CFBundleTypeName</key>
			<string>qlcconsole Workspace</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>qlcc</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.bransonmatheson.qlcconsole.workspace</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
		<dict>
			<key>CFBundleTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>CFBundleTypeName</key>
			<string>QLC+ Workspace</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>qxw</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.qlcplus.workspace</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
		<dict>
			<key>CFBundleTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>CFBundleTypeName</key>
			<string>QLC+ Fixture Definition</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>qxf</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.qlcplus.fixture</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>

	<!-- The file types behind CFBundleDocumentTypes' LSItemContentTypes. Without
	     a declaration macOS gives each extension a dyn.* type: Finder shows no
	     kind or icon, and Quick Look and Spotlight see opaque data. .qlcc is
	     ours, so exported; .qxw and .qxf are QLC+'s formats, so imported: if
	     QLC+ itself ever exports them, its declaration wins and ours defers.
	     All three are XML. (Linux: platforms/linux/qlcconsole.xml.) -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.bransonmatheson.qlcconsole.workspace</string>
			<key>UTTypeDescription</key>
			<string>qlcconsole Workspace</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qlcc</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-qlcconsole-workspace</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.qlcplus.workspace</string>
			<key>UTTypeDescription</key>
			<string>QLC+ Workspace</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qxw</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-qlc-workspace</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.qlcplus.fixture</string>
			<key>UTTypeDescription</key>
			<string>QLC+ Fixture Definition</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>qlcconsole.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qxf</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-qlc-fixture</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
