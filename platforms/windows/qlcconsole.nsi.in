; qlcconsole Windows installer.
;
; Generated by CMake (platforms/windows/CMakeLists.txt) from qlcconsole.nsi.in
; and installed next to qlcconsole.exe. Build it from that directory, after
; windeployqt has filled it and nsis-manifest.sh has listed it:
;
;   sh <source>/platforms/windows/nsis-manifest.sh
;   makensis qlcconsole.nsi
;
; The file list is generated rather than hand-kept: windeployqt's output
; (which Qt plugin folders, which DLLs) changes with every Qt release, and a
; hand-kept list silently ships an installer that cannot start.

;--------------------------------
;Include Modern UI
  !include "MUI2.nsh"

;--------------------------------
;Defines
!define QLCCONSOLE_SRC "@QLC_NSIS_SRCDIR@"
!define VERSION "@QLCCONSOLE_VERSION@"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\qlcconsole"
!define MUI_ICON "${QLCCONSOLE_SRC}\resources\icons\qlcconsole.ico"
!define MUI_UNICON "${NSISDIR}\Contrib\Graphics\Icons\nsis3-uninstall.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "${NSISDIR}\Contrib\Graphics\Header\nsis3-vintage.bmp"
!define MUI_HEADERIMAGE_LEFT
!define MUI_PAGE_HEADER_TEXT "qlcconsole ${VERSION}"

;--------------------------------
;General
Name "qlcconsole ${VERSION}"
OutFile "qlcconsole-${VERSION}-win64-setup.exe"
InstallDir C:\qlcconsole
InstallDirRegKey HKCU "Software\qlcconsole" "Install_Dir"
RequestExecutionLevel user
Unicode true

VIProductVersion "${VERSION}.0"
VIAddVersionKey /LANG=0 "ProductName" "qlcconsole"
VIAddVersionKey /LANG=0 "ProductVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "FileVersion" "${VERSION}"
VIAddVersionKey /LANG=0 "FileDescription" "qlcconsole installer"
VIAddVersionKey /LANG=0 "LegalCopyright" "Apache License 2.0"

!define MUI_LICENSEPAGE_TEXT_TOP "Do you accept the following statement of the Apache 2.0 license?"

!insertmacro MUI_PAGE_LICENSE "${QLCCONSOLE_SRC}\platforms\windows\apache_2.0.txt"

;--------------------------------
;Languages
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "SpanishInternational"
!insertmacro MUI_LANGUAGE "Czech"
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "Finnish"
!insertmacro MUI_LANGUAGE "Japanese"
!insertmacro MUI_LANGUAGE "Catalan"

;--------------------------------
; Pages
Page directory
Page custom StartMenuGroupSelect "" ": Start Menu Folder"
Page instfiles

Function StartMenuGroupSelect
	Push $R1

	StartMenu::Select /checknoshortcuts "Don't create a start menu folder" /autoadd /lastused $R0 "qlcconsole"
	Pop $R1

	StrCmp $R1 "success" success
	StrCmp $R1 "cancel" done
		; error
		MessageBox MB_OK $R1
		StrCpy $R0 "qlcconsole" # use default
		Return
	success:
	Pop $R0

	done:
	Pop $R1
FunctionEnd

Section
	SetOutPath $INSTDIR

	# A silent install (/S -- the in-app updater) skips the Start Menu
	# page, which would leave the shortcuts loose in Start Menu: the default.
	StrCmp $R0 "" 0 +2
		StrCpy $R0 "qlcconsole"

	# this part is only necessary if you used /checknoshortcuts
	StrCpy $R1 $R0 1
	StrCmp $R1 ">" skip
		CreateDirectory $SMPROGRAMS\$R0
		CreateShortCut '$SMPROGRAMS\$R0\qlcconsole.lnk' $INSTDIR\qlcconsole.exe
		CreateShortCut '$SMPROGRAMS\$R0\Fixture Definition Editor.lnk' $INSTDIR\qlcconsole-fixtureeditor.exe
		CreateShortCut '$SMPROGRAMS\$R0\Uninstall.lnk' $INSTDIR\uninstall.exe
		WriteRegStr HKCU "Software\qlcconsole" "StartMenu_Dir" "$SMPROGRAMS\$R0"

	skip:
SectionEnd

Section
	SetOutPath $INSTDIR
	!include "manifest-install.nsh"
	SetOutPath $INSTDIR

	; Per-user file associations: with RequestExecutionLevel user, HKCR
	; resolves to HKLM\Software\Classes and every write there is refused.
	WriteRegStr HKCU "Software\Classes\.qlcc" "" "QLCConsole.Document"
	WriteRegStr HKCU "Software\Classes\.qxw" "" "QLCConsole.Document"
	WriteRegStr HKCU "Software\Classes\QLCConsole.Document" "" "qlcconsole Workspace"
	WriteRegStr HKCU "Software\Classes\QLCConsole.Document\DefaultIcon" "" "$INSTDIR\qlcconsole.exe,0"
	WriteRegStr HKCU "Software\Classes\QLCConsole.Document\shell\open\command" "" '"$INSTDIR\qlcconsole.exe" --open "%1"'

	WriteRegStr HKCU "Software\Classes\.qxf" "" "QLCConsoleFixture.Document"
	WriteRegStr HKCU "Software\Classes\QLCConsoleFixture.Document" "" "qlcconsole Fixture"
	WriteRegStr HKCU "Software\Classes\QLCConsoleFixture.Document\DefaultIcon" "" "$INSTDIR\qlcconsole-fixtureeditor.exe,0"
	WriteRegStr HKCU "Software\Classes\QLCConsoleFixture.Document\shell\open\command" "" '"$INSTDIR\qlcconsole-fixtureeditor.exe" --open "%1"'

	WriteRegStr HKCU "Software\qlcconsole" "Install_Dir" "$INSTDIR"

	; Apps & features entry
	WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "qlcconsole"
	WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
	WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\qlcconsole.exe,0"
	WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
	WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
	WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1

	WriteUninstaller $INSTDIR\uninstall.exe
SectionEnd

;--------------------------------
; Uninstallation

UninstPage uninstConfirm
UninstPage instfiles
Section "Uninstall"
	Delete $INSTDIR\uninstall.exe
	; Only what the installer put there -- never RMDir /r $INSTDIR, which
	; would take the user's own files with it if they installed into a
	; folder that was already in use.
	!include "manifest-uninstall.nsh"
	RMDir $INSTDIR

	ReadRegStr $R0 HKCU "Software\qlcconsole" "StartMenu_Dir"
	StrCmp $R0 "" nostartmenu
		Delete "$R0\qlcconsole.lnk"
		Delete "$R0\Fixture Definition Editor.lnk"
		Delete "$R0\Uninstall.lnk"
		RMDir "$R0"
	nostartmenu:

	DeleteRegKey HKCU "Software\Classes\.qlcc"
	DeleteRegKey HKCU "Software\Classes\.qxw"
	DeleteRegKey HKCU "Software\Classes\QLCConsole.Document"

	DeleteRegKey HKCU "Software\Classes\.qxf"
	DeleteRegKey HKCU "Software\Classes\QLCConsoleFixture.Document"

	DeleteRegKey HKCU "${UNINSTALL_KEY}"

	; This will delete all settings
	DeleteRegKey HKCU "Software\qlcconsole"
SectionEnd
