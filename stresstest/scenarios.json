  ],
  "capability": [
    {"name": "ceiling-light",  "mode": "ramp", "args": ["--scenes","20","--chasers","4","--matrices","2","--efx","2","--collections","2","--fixtures-per-uni","120"]},
    {"name": "ceiling-heavy",  "mode": "ramp", "args": ["--scenes","100","--chasers","20","--matrices","20","--efx","20","--collections","8","--fixtures-per-uni","100"]}
